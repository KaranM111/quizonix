# Copy this file to ".env" and fill in your own values

# Any random long string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# The secret code an admin must type in while registering an admin account
ADMIN_SECRET=change_this_admin_signup_code

# FREE Google Gemini API key (used to auto-generate MCQs from your PPTs)
# Get one at: https://aistudio.google.com/apikey  (no credit card needed for free tier)
GEMINI_API_KEY=your_free_gemini_api_key_here

# Port the server runs on
PORT=3000
